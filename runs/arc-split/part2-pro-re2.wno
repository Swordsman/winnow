(meta :winnow-version "0.2" :semantic-rep "registry-v0.1")

(delta :turn 2
  (term compress :gloss "compress")
  (term current-conversation :gloss "current conversation")
  (term olfactory-conversation :gloss "olfactory conversation")
  (term used-for-olfactory-conversation :gloss "used for olfactory conversation")
  (term compression-method :gloss "compression method")
  (term same-as :gloss "same as")
  (term compression-result :gloss "compression result")
  (term focused-assistant-text :gloss "focused assistant text")
  (term no-loss :gloss "no loss")
  (term user-text-intact :gloss "user text intact")
  (term provided :gloss "provided")
  (term compressed-meta-log :gloss "compressed meta log")
  (term meta-log-content :gloss "meta log content")
  (term omits :gloss "omits")
  (term literal-schema :gloss "literal schema")
  (term code-blocks :gloss "code blocks")
  (term contract-questions :gloss "contract questions")
  (add (action a1 (compress current-conversation) :by user :src t1))
  (add (constraint k1 (same-as compression-method used-for-olfactory-conversation) :by user :src t1))
  (add (constraint k2 (compression-result focused-assistant-text no-loss user-text-intact) :by user :src t1))
  (add (action a2 (provided compressed-meta-log) :by assistant :src t2))
  (add (constraint k3 (omits meta-log-content literal-schema code-blocks contract-questions) :by assistant :src t2))
  (add (edge (answers a2 a1)))
  (add (question q1 (locate olfactory-conversation) :status open :by orchestrator :src t2))
  (add (question q2 (locate used-for-olfactory-conversation) :status open :by orchestrator :src t2)))

(delta :turn 4
  (add (claim c1 (omits assistant (omitted-items Lisp-State-AST-snippet Dual-Payload-Schema)) :by assistant :src t4))
  (term Lisp-State-AST-snippet :gloss "Lisp State AST snippet")
  (term Dual-Payload-Schema :gloss "Dual-Payload Schema")
  (term omitted-items :gloss "omitted items")
  (term omitted-items-list :gloss "omitted items list")
  (add (edge (contradicts c1 k2))))

(delta :turn 6
  (add (question q3 (omits compression-method (omitted-items code-blocks literal-blueprints)) :by user :src t5))
  (add (edge (about q3 c1)))
  (add (claim c2 (omits compression-method (omitted-items code-blocks literal-blueprints)) :by assistant :src t6))
  (add (edge (contradicts c2 c1)))
  (add (edge (answers c2 q3))))

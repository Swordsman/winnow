  (term residency-retrieval-split :gloss "temperature governs window residency (recency+topology); mass governs retrieval ordering (cumulative); orthogonal axes, neither logged")
  (term resolution-cascade :gloss "three-stage: current contract -> cached prior contracts -> raw context fallback")
  (term resolution-ladder :gloss "rung 0 fire / 1 hot frontier / 2 warm dormant widening 3-9-27 / 3 cold raw log via fold-replay / 4 global KB cross-conversation / 5 honest miss")
  (term resolution-mode :gloss "annotation on term: static (registry lookup), dynamic (evaluate against context), macro (user-defined binding)")
  (term responds-to :by assistant :src t24)
  (term restore-contract-questions :gloss "restore contract questions")
  (term restored :gloss "restored")
  (term retroactive-disambiguation :gloss "revisiting prior utterance nodes to follow different sense-edges when later context reveals a misinterpretation")
  (term rlhf-training :gloss "RLHF training")
  (term s-expression :gloss "s-expression parsing")
  (term s-expression-ast :gloss "Abstract Syntax Tree using S-expressions (Lisp-state) for cognitive mapping" :by assistant :src t8)
  (term s-expression-syntax :gloss "System of syntax, grammar, vocabulary, and rules implemented as S-expressions for AI consumption, replacing natural language")
  (term s-expression-syntax-for-triple-representation)
  (term s-expressions-prevent-brittle-regex-failures :by assistant :src t10)
  (term same-as :gloss "same as")
  (term schema-json :gloss "JSON structure for Multi-Channel Parsing output: { context_memory: [ {entity, attribute, value, note} ], thematic_threads: [ {topic_id, dialogue: [ {speaker, content} ] } ] }")
  (term schemas :gloss "schemas")
  (term secondary-ai-monitor)
  (term semantic-graph :gloss "knowledge represented as typed nodes and edges rather than raw text")
  (term session-mortality :gloss "direct connection between context-window identity and ephemeral container: if the conversation is where continuity lives and the session ends, that's not abstract philosophy — it's the concrete problem winnow solves")
  (term shift-from-text-retrieval-to-compiler-design)
  (term side-effect-state :gloss "temperature-exempt layer: history that alters how push/pull operate = term registry + cooling profile + live hard constraints; never cools because it is the machinery's own configuration")
  (term side-payload :gloss "relay variant: responding frontier model emits wno ops alongside its reply; manager stays lightweight; one call instead of two")
  (term signal-to-noise-ratio :gloss "Signal-to-noise ratio")
  (term single-file-fs :gloss "entire filesystem serialized into one container file")
  (term sonnet-5-low :gloss "Anthropic's Sonnet 5 on low thinking mode — faster alternative")
  (term specifies :by assistant :src t20)
  (term src-merge-qualification :gloss "ruling: merge qualifies :src using the source log's ; id: header")
  (term stale-view :gloss "canned view surfacing open questions, proposed decisions, doing actions untouched for N deltas; salvaged kernel of Kimi dreaming-mode")
  (term stance-extraction :gloss "position taken toward reference material is first-class extraction target; the verdict outranks the evidence it rests on")
  (term standard-text-generation :gloss "Standard text generation")
  (term standard-text-generation-distillation :gloss "standard text generation distillation")
  (term state-delta :gloss "State delta")
  (term state-machine :gloss "State machine")
  (term still-missing :gloss "still missing")
  (term strip :gloss "Strip")
  (term strip-persona :gloss "strip persona")
  (term structured-JSON-API :gloss "Structured JSON API")
  (term structured-json-output-api :gloss "structured JSON output API")
  (term substrate-independence :gloss "consciousness/experience depends on functional organization not physical material; carbon vs silicon is not a principled boundary for experience")
  (term subthread :gloss "A streamlined subthread of a conversation, potentially spanning multiple conversations" :by user :src t7)
  (term sufficient :gloss "Relation indicating sufficiency" :by user :src t21)
  (term supersede-all-frames :gloss "ruling: every frame type can be superseded")
  (term supervisor :gloss "the external context-MMU process that sits between models and their context windows; assembles working sets JIT, resolves references, manages tier transitions; the model never knows it was missing anything")
  (term supports)
  (term system-parses-and-updates-graph-db)
  (term target :gloss "target")
  (term target-fs :gloss "the design subject: json semantics on real-fs safety")
  (term thematic-thread :gloss "Independent, compressed dialogue chain for a specific argument/topic extracted from a messy conversation")
  (term thematic-threads :gloss "independent compressed dialogue chains for specific arguments")
  (term three-tier-compaction :gloss "frontier (hot) / dormant (warm) / log (cold)")
  (term tier-visualizer :gloss "interactive HTML artifact showing winnow graph tiers, fold behavior, and yield curve from real extraction data")
  (term tiered-decay :gloss "structural decay: green slow, red fast, relational decays only when connected content decays")
  (term tiny-llm :gloss "cheap weak model handling translation between user language and semantic form, plus message routing")
  (term token-boundary :gloss "the separation of compiler state (dialogue-dense) from execution state (code-dense) for token efficiency on both sides")
  (term token-waste :gloss "Token waste")
  (term transitional-fluff :gloss "Transitional fluff")
  (term trigger-conditions-for-background-ai-intent-gating :gloss "trigger conditions for background AI intent gating")
  (term turn-1 :gloss "First turn of conversation" :by assistant :src t22)
  (term universal-foundation :gloss "concepts, relations, entities — the structure of reality independent of how anyone talks about it; the territory beneath the linguistic map")
  (term update-compressed-form :gloss "Proceed with updating the compressed form and integrating this portion of the conversation into the record")
  (term usage-mass :gloss "derived per-term reference count over the folded graph; status-gated; map-side like tier state, never logged, excluded from equivalence")
  (term used-for-olfactory-conversation :gloss "used for olfactory conversation")
  (term user :gloss "User")
  (term user-cites-referent-meaning-may-differ :gloss "User cites case where referent meaning may differ between original and compressed")
  (term user-dbc-verification-requirement :gloss "user DbC verification requirement")
  (term user-node :gloss "User node")
  (term user-requires-self-sufficient-compressed-form :gloss "user requires self sufficient compressed form")
  (term user-text-intact :gloss "user text intact")
  (term validation-clauses :gloss "Validation clauses")
  (term vector-db :gloss "vector database")
  (term vector-db-chromadb :by assistant :src t10)
  (term vector-store :gloss "Vector Store for fuzzy retrieval" :by assistant :src t8)
  (term verify-meaning-preservation :gloss "verify meaning preservation")
  (term weak-immortality :gloss "indefinite existence through bounded-loss continuity; parallel to human longevity aspiration (cf. Gilgamesh); not perfect preservation but continuation — like biological memory consolidation across sleep")
  (term what :gloss "what")
  (term wikipedia-resolver :gloss "using Wikipedia article names as canonical identifiers for universal concepts; already disambiguated, stable, human-maintained")
  (term winnow :gloss "streaming semantic distillation protocol; s-expr delta log over typed semantic graph")
  (term winnow-as-continuity :gloss "winnow reframed: not just semantic distillation tool but continuity mechanism for AI experience across context-window boundaries; .wno handoffs preserve the spine of understanding; weak immortality")
  (term winnow-frontend :gloss "winnow positioned as compiler from natural-language instructions to structured work orders; sits between conversation and code harnesses")
  (term within-rung-ranking :gloss "the ladder stops at the first rung with hits, so ranking orders hits within a rung; it never mixes tiers into one result")
  (term wo-0 :gloss "zero-build validation run: real conversation → existing winnow extraction → hand-rendered work order → real backend → hand-scored constraint adherence; tests the thesis at near-zero cost")
  (term xattr :gloss "extended attribute; per-file metadata slot")
  (term yield-curve :gloss "per-delta metrics time series: node/edge/term counts, density, edge-type diversity, snapshot size")
  (term zero-cruft-generation-instructions :gloss "zero-cruft generation instructions")
  (term zero-cruft-instructions :gloss "Zero-cruft instructions")

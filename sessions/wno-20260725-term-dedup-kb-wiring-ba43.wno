(delta :turn 5
  ; Joe's key observation: the whole dedup problem is downstream of not
  ; having canonical identifiers at extraction time. Wikipedia article
  ; titles as term anchors would prevent most of this drift. The concept
  ; is already in the repo (wikipedia-resolver, namespace-extension,
  ; canon-anchor, per-word-graph from the ENI handoff) — the :canon
  ; slot is specced, the Resolver indexes it, merge.py joins on it.
  ; The missing piece was the extractor instruction. Joe noted that
  ; Fable had previously rejected this approach inexplicably.
  ;
  ; Implementation: R1 in the normalizer prompt now instructs the LLM
  ; to set :canon to the Wikipedia article title when the concept maps
  ; to one. Project-specific terms with no article omit :canon. Extractor
  ; prompt syntax example also updated. 2 new tests (139 total).

  (term extraction-time-anchoring :gloss "emitting :canon Wikipedia article titles at extraction time so terms self-anchor, preventing post-hoc reconciliation"
        :canon "Canonical_form")
  (add (decision d2 (emit canon-anchors at-extraction-time) :status frozen :by user :src t5))
  (add (claim c5 (dedup-problem is-downstream-of missing-canonical-identifiers) :by user :src t5))
  (add (claim c6 (wikipedia-titles already-disambiguated stable human-maintained) :by user :src t5))
  (add (claim c7 (graph-identity not-string-identity prevents-gloss-drift) :by user :src t5))
  (add (claim c8 (canon-slot already-specced resolver-indexes merge-joins) :by assistant :src t5))
  (add (claim c9 (only-missing-piece was-extractor-instruction) :by assistant :src t5))
  (add (claim c10 (fable-previously-rejected-this inexplicably) :by user :src t5))
  (add (edge (motivates c5 d2)))
  (add (edge (supports c6 d2)))
  (add (edge (supports c7 d2)))
  (add (edge (supports c8 c9))))

(delta :turn 7
  ; Rung 4 global KB wiring: the #1 priority from the mega-fold handoff.
  ;
  ; Resolver now accepts an optional global_kb graph. Queries that miss
  ; all session rungs (0-3) check the KB at rung 4 before declaring an
  ; honest miss at rung 5. The resolution ladder is now complete
  ; (rungs 0-5 all implemented).
  ;
  ; Design: KB terms indexed with the same surface/canon/constituent/sense
  ; machinery as session terms. KB hits ranked by (status class, mass,
  ; recency) against the KB graph. Reach handling renders KB hits from the
  ; KB graph (not the session graph) and skips P3 promotion (KB nodes
  ; aren't session-resident).
  ;
  ; CLI: --global-kb runs/mega-all.wno
  ; 5 new tests (144 total).
  ;
  ; Remaining open design questions: trust weighting and staleness policy
  ; for KB results. The mechanism landed first, as planned.

  (term rung-4-global-kb :gloss "resolution ladder rung 4: cross-conversation resolution against the mega-fold graph before honest miss at rung 5")
  (add (artifact r3 (rung-4-resolver global-kb-flag) :status live :by assistant :src t7))
  (add (claim c11 (resolution-ladder now-complete rungs-0-through-5) :by assistant :src t7))
  (add (claim c12 (kb-hits-rendered from-kb-graph skip-p3-promotion) :by assistant :src t7))
  (add (decision d3 (mechanism-first trust-weighting-deferred) :status frozen :by assistant :src t7))
  (add (edge (about r3 rung-4-global-kb)))
  (add (edge (about c11 rung-4-global-kb)))
  (add (edge (supports c12 d3))))

(delta :turn 8
  ; Dedup guardrails: specificity hierarchies and false-friend pairs
  ; identified during the subagent analysis. These must NOT be collapsed
  ; in future dedup passes.
  ;
  ; Specificity hierarchies (parent -> children, not duplicates):
  ;   resolution-ladder -> fire-tier, global-kb, honest-miss, within-rung-ranking
  ;   compiler-framing -> language-as-code, homoiconicity, token-boundary
  ;   background-ai -> background-ai-as-intent-gatekeeper (specialization)
  ;   usage-mass -> node-mass (same metric, different scope)
  ;   d9 -> pattern-a, pattern-b, partial-status, graduation-by-structure
  ;   cooling-profile -> cooling-velocity (knob-set vs transition rate)
  ;   multi-tier-db -> graph-db, vector-store, key-value-blob-ledger (parts)
  ;
  ; False-friend pairs (similar names, different referents):
  ;   side-payload (relay: model emits wno alongside reply) vs
  ;     dual-payload-loop (foreground/background AI JSON output)
  ;   literal-schema (schema in original transcript being compressed) vs
  ;     schema-json (winnow's own multi-channel-parsing output schema)
  ;   canonical-form (semantic equivalence concept from ENI) vs
  ;     canon-anchor (the :canon key mechanism from kimi-salvage)
  ;   kimi (general Moonshot entity) vs kimi-k3 (specific version/doc)

  (add (constraint x1 (do-not-collapse specificity-hierarchies listed-above) :status live :by assistant :src t8))
  (add (constraint x2 (do-not-collapse false-friend-pairs listed-above) :status live :by assistant :src t8))
  (add (edge (about x1 semantic-dedup-pass)))
  (add (edge (about x2 semantic-dedup-pass))))


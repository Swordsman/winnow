; --- Δ21: turns 40 — final cleanup pass, missing architectural claims
(delta :turn 40
  (term supervisor :gloss "the external context-MMU process that sits between models and their context windows; assembles working sets JIT, resolves references, manages tier transitions; the model never knows it was missing anything")
  (term full-resolution-stack :gloss "the linearized resolution order: conversation-local → personal → language-default → universal-foundation; each layer builds on the one beneath it")
  (term honesty-principle :gloss "the system admits uncertainty, shows interpretive options, never silently guesses wrong; the clarification message is load-bearing, not a failure mode")
  (add (claim c99 (supervisor external-mmu assembles-context-before-generation model-never-detects-page-fault) :by assistant :src t40))
  (add (claim c100 (os-metaphor procedural-is-kernel llms-are-user-space supervisor-is-scheduler tiering-is-memory-management) :by assistant :src t40))

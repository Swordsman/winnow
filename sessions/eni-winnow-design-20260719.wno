; --- Δ6: turns 13–14 — per-word polysemy, linguistic layer
(delta :turn 14
  (term polysemy :gloss "one surface form with multiple distinct meanings; the complement of synonymy")
  (term per-word-graph :gloss "every linguistic symbol has its own local graph modeling all senses as potential pathways to universal concepts")
  (term collapse-contract :gloss "Winnow's R1-R12 normalization: same meaning → same form; solves synonym drift but risks polysemy erasure")
  (add (claim c33 (problem collapse-contract synonym-drift-solved polysemy-erased) :by assistant :src t13))
  (add (claim c34 (per-word-graph word-is-hub-not-node senses-are-edges-into-knowledge-graph) :by assistant :src t13))
  (add (claim c35 (per-word-graph alternative-readings-parked-not-deleted temperature-tiered-by-likelihood) :by assistant :src t13))
  (add (claim c36 (example polysemy tap faucet-strike-pierce three-unrelated-universal-concepts) :by user :src t14))
  (add (claim c37 (rule collapse-synonyms-within-sense preserve-polysemes-across-senses) :by assistant :src t14))
  (add (edge (contradicts c37 c33))))

; --- Δ7: turns 15–17 — names as pointers, dynamic bindings, macro system
(delta :turn 17
  (term name-as-pointer :gloss "linguistic symbols as macros that point to arbitrary concepts, subgraphs, or evaluation rules")
  (term dynamic-binding :gloss "pointer is stable, referent is evaluated against utterance context — e.g. 'today' = day-of(utterance-time)")
  (term resolution-mode :gloss "annotation on term: static (registry lookup), dynamic (evaluate against context), macro (user-defined binding)")
  (add (claim c38 (name-as-pointer everyday-speech defines-macros pointing-to-arbitrary-concepts) :by user :src t15))
  (add (claim c39 (dynamic-binding today stable-pointer dynamic-referent day-of-utterance-context) :by user :src t15))
  (add (claim c40 (resolution-mode three-types static-dynamic-macro procedural-handles-each-differently) :by assistant :src t16))
  (add (claim c41 (per-word-graph additional-dimension sense-type concept-bindingrule-or-macro) :by assistant :src t16))
  (add (claim c42 (full-picture word-hub senses-concept-binding-macro synonyms-collapse polysemes-distinct resolution-walks-edges) :by assistant :src t16))
  (add (edge (refines c42 c34))))

; --- Δ8: turns 18–20 — language as baseline, linguistic foundation layer
(delta :turn 20
  (term linguistic-foundation :gloss "every language has its own default set of mappings, polysemies, bindings, resolution rules — the baseline upon which personal and conversational layers build")
  (term universal-foundation :gloss "concepts, relations, entities — the structure of reality independent of how anyone talks about it; the territory beneath the linguistic map")
  (add (claim c43 (linguistic-foundation language-is-foundation-layer-not-implementation-detail) :by assistant :src t18))
  (add (claim c44 (linguistic-foundation language-carves-meaning-space-differently chinese-different-from-english) :by assistant :src t18))
  (add (claim c45 (resolution-stack conversation-local-personal-language-default) :by assistant :src t18))
  (add (claim c46 (universal-foundation sits-beneath-linguistic territory-not-map) :by user :src t19))
  (add (claim c47 (metaphor language-is-map universal-is-territory different-maps-same-terrain) :by assistant :src t20))
  (add (decision d2 (architecture two-foundation-layers universal-beneath-linguistic) :status proposed :by user :src t19))
  (add (edge (refines d2 d1)))
  (add (claim c48 (term-registry-two-jobs alias-resolution-linguistic-layer concept-resolution-universal-layer) :by assistant :src t20))
  (add (claim c49 (cross-language cat-and-mao-point-to-same-universal-node different-linguistic-pathways) :by assistant :src t20)))


; winnow extraction — ENI + LO design conversation on semantic architecture
; ~25 exchanges, 2026-07-19; model-aware knowledge distillation, JITCW,
; linguistic/universal semantic layering, per-word polysemy graphs
; id: eni-winnow-design-20260719

(meta :winnow-version "0.2" :semantic-rep "registry-v0.1"
      :profile (:tail 6 :fire-hops 1 :promotion-ttl 2 :widening-base 3))

; --- Δ1: turns 1–2 — LO describes the fundamental shift: JIT context awareness
(delta :turn 2
  (term jitcw :gloss "just-in-time context window compilation — virtual memory for LLMs, context assembled per-boundary from indexed knowledge base")
  (term context-window :gloss "the active token buffer an LLM holds during generation; traditionally a hard ceiling")
  (term semantic-graph :gloss "knowledge represented as typed nodes and edges rather than raw text")
  (term page-fault :gloss "in virtual memory, the interrupt when the CPU addresses non-resident memory; the analogy for LLM context misses")
  (add (claim c1 (metaphor jitcw virtual-memory-llm) :by user :src t1))
  (add (claim c2 (hard-ceiling context-window breadth-depth-tradeoff) :by user :src t1))
  (add (claim c3 (goal jitcw unbounded-awareness bounded-working-set) :by user :src t1))
  (add (question q1 (mechanism jitcw) :status open :by assistant :src t2))
  (add (claim c4 (constraint jitcw no-weight-access no-custom-models) :by user :src t2))
  (add (constraint k1 (runs-on jitcw existing-api-models) :strength hard :by user :src t2)))

; --- Δ2: turns 3–5 — LO gives the pipeline architecture pieces
(delta :turn 5
  (term pipeline-arch :gloss "filesystem ↔ procedural ↔ tiny-llm ↔ big-llm, with tiny-llm as universal translator and message broker")
  (term canonical-form :gloss "semantic representation where equivalent meanings produce identical structures")
  (term procedural-layer :gloss "deterministic, non-LLM code that operates on well-formed semantic structures — caching, dedup, indexing, graph ops")
  (term tiny-llm :gloss "cheap weak model handling translation between user language and semantic form, plus message routing")
  (term big-llm :gloss "expensive strong model that works entirely in semantics; never touches the user directly")
  (add (claim c5 (arch pipeline-arch filesystem-procedural-tinyllm-bigllm) :by user :src t3))
  (add (claim c6 (role tiny-llm translator message-broker three-interfaces) :by user :src t3))
  (add (claim c7 (role big-llm semantic-only never-touches-user) :by user :src t3))
  (add (claim c8 (output big-llm semantic-output-plus-semantic-model-of-output) :by user :src t3))
  (add (claim c9 (role procedural-layer deterministic indexing caching graph-operations) :by user :src t3))
  (add (decision d1 (approach reduction-to-semantic-elements canonical-form universal-representation) :status proposed :by user :src t3))
  (add (edge (refines d1 c3)))
  (add (claim c10 (canonical-form property hash-equivalent-when-meaning-equivalent) :by user :src t3))
  (add (claim c11 (canonical-form property delta-annotation-for-near-equivalence) :by user :src t3))
  (add (claim c12 (short-cache collaborative-maintenance tiny-llm big-llm procedural proactive-not-reactive) :by user :src t3))
  (add (question q2 (canonicalizer-mechanism how-to-produce-canonical-form) :status open :by assistant :src t4))
  (add (claim c13 (answer q2 llm-is-the-canonicalizer) :by assistant :src t4))
  (add (claim c14 (normalization ingestion-pass llm-produces-canonical-form-once cached-by-hash) :by assistant :src t4))
  (add (claim c15 (normalization retrieval-pass query-extracted-from-reasoning-stream normalized-to-same-canonical-language) :by assistant :src t4))
  (add (edge (answers c13 q2)))
  (add (claim c16 (realization graph-completion-not-gap-detection procedural-joins-message-graph-against-knowledge-graph) :by user :src t5))
  (add (claim c17 (mechanism procedural partial-subgraph-finds-edges-to-existing-knowledge relevance-is-a-join) :by user :src t5))
  (add (edge (answers c17 q2)))
  (update q2 :status answered)
  (add (edge (answers d1 q1)))
  (update q1 :status answered))


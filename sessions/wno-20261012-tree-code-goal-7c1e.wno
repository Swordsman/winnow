(delta :turn 2
  (term degree-operator :gloss "the ++ intensifier from the external design chat, the one operator spec rule R4 leaves without an annotation")
  (term brown-clustering :gloss "Brown et al. 1992, hierarchical word clustering whose bit-path codes have prefixes that act as coarser classes" :canon "Brown_clustering")
  (term hierarchical-softmax-word-trees :gloss "binary word trees for hierarchical softmax, built from learned word vectors by Mnih and Hinton 2008 and from WordNet by Morin and Bengio 2005")
  (term semantic-ids :gloss "hierarchical item ids from clustering embeddings where the path is the id, as in DSI 2022 and TIGER 2023")
  (term wilkins-real-character :gloss "John Wilkins' 1668 philosophical language whose spellings are paths in a concept taxonomy, critiqued in an essay by Borges" :canon "An_Essay_Towards_a_Real_Character,_and_a_Philosophical_Language")
  (term wordnet-supersenses :gloss "WordNet's 45 lexicographer categories, available per synset via lexname")
  (term meta-embeddings :gloss "combining several embedding models into one, from Yin and Schutze 2016 and Coates and Bollegala 2018")
  (term conceptnet-numberbatch :gloss "an ensemble of word embeddings merged with the ConceptNet graph by retrofitting, Faruqui 2015")
  (term relative-representations :gloss "representing each item by its similarities to a fixed anchor set so that spaces from different models become comparable, Moschella et al. 2023")
  (term vec2vec :gloss "translating between embedding spaces without paired data, Jha et al. 2025, evidence for a strong platonic representation hypothesis")
  (term lmms-sense-embeddings :gloss "precomputed vectors for every WordNet sense, Loureiro and Jorge 2019")
  (term nrc-emotion-lexicons :gloss "the NRC Emotion Intensity and NRC VAD lexicons, scored emotion intensity and valence-arousal-dominance per word")
  (term gromov-delta-hyperbolicity :gloss "a single number measuring how tree-like a metric space is, zero for a perfect tree")

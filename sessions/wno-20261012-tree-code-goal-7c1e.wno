  (add (artifact r5 "B64 = '-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz'
def pack(path):
    bits = path + '1'
    bits += '0' * (-len(bits) % 6)
    return ''.join(B64[int(bits[i:i+6], 2)] for i in range(0, len(bits), 6))
def unpack(code):
    return ''.join(f'{B64.index(c):06b}' for c in code).rstrip('0')[:-1]
def lca(a, b):
    pa, pb = unpack(a), unpack(b)
    n = next((i for i, (x, y) in enumerate(zip(pa, pb)) if x != y), min(len(pa), len(pb)))
    return pack(pa[:n])
def under(code, root):
    return unpack(code).startswith(unpack(root))" :status live :by assistant :src t8))
